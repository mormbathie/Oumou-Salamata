

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String     @id @default(cuid())
  email    String  @unique
  password String
  role     Role
  firstName String? 
  lastName  String?
  phone     String?
}

enum Role {
  ADMIN
  TEACHER
  PARENT
  MANAGER
}
